{
  "name": "electron-starter",
  "version": "1.0.0",
  "packageManager": "pnpm@11.1.3",
  "description": "Open-source Electron + React desktop app starter: type-safe IPC, tray, deep links, settings, command palette, i18n",
  "main": "./out/main/main.js",
  "license": "MIT",
  "author": {
    "name": "SoarStarter",
    "url": "https://soarstarter.com"
  },
  "homepage": "https://github.com/soarstarter/electron-starter",
  "repository": {
    "type": "git",
    "url": "https://github.com/soarstarter/electron-starter"
  },
  "bugs": {
    "url": "https://github.com/soarstarter/electron-starter/issues"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "lint:check": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc -b --noEmit",
    "check:lite": "node scripts/check-lite.mjs",
    "test": "pnpm test:core",
    "test:core": "vitest run --config vitest.core.config.ts",
    "test:all": "vitest run",
    "test:unit": "pnpm test:all",
    "test:unit:watch": "vitest",
    "start": "electron-vite preview",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
    "prepare": "node scripts/install-git-hooks.mjs",
    "vite:build:app": "electron-vite build",
    "electron:build:win": "electron-builder --win",
    "electron:build:mac": "electron-builder --mac",
    "electron:build:linux": "electron-builder --linux",
    "electron:build:dir": "electron-builder --dir",
    "build:unpack": "run-s vite:build:app electron:build:dir",
    "build:win": "run-s vite:build:app electron:build:win",
    "build:mac": "run-s vite:build:app electron:build:mac",
    "build:linux": "run-s vite:build:app electron:build:linux",
    "analyze:bundle": "node scripts/analyze-bundle.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-log": "^5.4.4",
    "i18next": "^26.2.0",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.4.3",
    "react-hook-form": "^7.76.1",
    "react-i18next": "^16.6.6",
    "react-router": "^7.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "use-sync-external-store": "^1.6.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.7"
  }
}
