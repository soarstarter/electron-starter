# Template showcase (renderer + main)
# [template-demo] Set both to "false" to preview the app without the demo
# surfaces before deleting them (see docs/CUSTOMIZE.md). Keep the two in sync so
# native menus and renderer routes hide together.
VITE_SHOWCASE_ENABLED=true
MAIN_VITE_SHOWCASE_ENABLED=true

# Support / repository (renderer, optional)
# Overrides the repo used by the Help "Report a bug" and About "Repository"
# links. Falls back to REPO_URL in shared/constants.ts when unset.
VITE_REPO_URL=
